# Copia este archivo a .env y ajusta los valores para tu entorno.
# docker compose lee .env automaticamente desde la carpeta backend/.
#
# IMPORTANTE: estos puertos NO deben coincidir con los de KIVO
# (KIVO usa 5432 para PostgreSQL y 3000 para su backend).

POSTGRES_USER=cafe
POSTGRES_PASSWORD=cafe_secret
POSTGRES_DB=cafe_db
POSTGRES_PORT=5433

API_PORT=8080

# Cambia esto en produccion (cadena larga y aleatoria)
JWT_SECRET=cafe-aroma-dev-secret-change-me
JWT_EXPIRES_IN=7d

SEED_ADMIN_EMAIL=admin@cafearoma.com
SEED_ADMIN_PASSWORD=admin123
SEED_CLIENT_EMAIL=cliente@cafearoma.com
SEED_CLIENT_PASSWORD=cliente123
